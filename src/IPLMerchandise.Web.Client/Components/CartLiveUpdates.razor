@* No markup. Keeps the open cart or checkout page current by events, not polling:
   - the API pushes "these products changed" (price, stock, availability) and we re-read the cart only if it holds one
     of them; the server then flags the change and checkout stays blocked until the new total is accepted;
   - after a dropped connection comes back, or when the customer returns to the tab, the cart is re-read once,
     because pushes may have been missed meanwhile.
   Checkout is still re-validated by the server, so even a change nobody was told about cannot be bought at the old price. *@
@implements IAsyncDisposable
@inject CartState Cart
@inject IProductUpdates Updates
@inject IJSRuntime JS

@code {
    private IJSObjectReference? _module;
    private IJSObjectReference? _watch;
    private DotNetObjectReference<CartLiveUpdates>? _self;
    private string[] _watched = [];
    private bool _refreshing;
    private bool _refreshAgain;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Updates.ProductsChanged += OnProductsChanged;
        Updates.Reconnected += OnReconnected;
        Cart.Changed += OnCartChanged;
        await FollowCartAsync();

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference?>("import", "./js/cart-refresh.js");
            if (_module is not null)
            {
                _self = DotNetObjectReference.Create(this);
                _watch = await _module.InvokeAsync<IJSObjectReference?>("watch", _self);
            }
        }
        catch (JSException)
        {
            // Pushes still work; only the "re-check on return to the tab" shortcut is lost.
        }
    }

    /// <summary>Called by the script when the customer returns to the tab.</summary>
    [JSInvokable]
    public Task OnVisibleAsync() => RefreshAsync();

    private void OnProductsChanged(IReadOnlyList<string> productIds)
    {
        if (productIds.Any(_watched.Contains)) _ = InvokeAsync(RefreshAsync);
    }

    private void OnReconnected() => _ = InvokeAsync(RefreshAsync);

    // Lines added or removed: follow the new set of products (no call when the set is unchanged).
    private void OnCartChanged() => _ = InvokeAsync(FollowCartAsync);

    private async Task FollowCartAsync()
    {
        var ids = Cart.Cart?.Lines.Select(l => l.ProductId).Distinct().Order(StringComparer.Ordinal).ToArray() ?? [];
        if (_disposed || ids.SequenceEqual(_watched)) return;
        _watched = ids;
        await Updates.WatchAsync(ids);
    }

    // Several pushes in a burst cause at most one extra read after the one in flight.
    private async Task RefreshAsync()
    {
        if (_disposed) return;
        if (_refreshing)
        {
            _refreshAgain = true;
            return;
        }
        _refreshing = true;
        try
        {
            do
            {
                _refreshAgain = false;
                await Cart.RefreshQuietlyAsync();
            } while (_refreshAgain && !_disposed);
        }
        finally
        {
            _refreshing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Updates.ProductsChanged -= OnProductsChanged;
        Updates.Reconnected -= OnReconnected;
        Cart.Changed -= OnCartChanged;
        _ = Updates.WatchAsync([]); // stop hearing about these products; the shared connection stays for the next page
        try
        {
            if (_watch is not null)
            {
                await _watch.InvokeVoidAsync("dispose");
                await _watch.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // page is going away
        }
        _self?.Dispose();
    }
}
