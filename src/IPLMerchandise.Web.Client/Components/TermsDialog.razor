<MudDialog Class="terms-dialog" aria-labelledby="terms-dialog-title">
    <TitleContent>
        <MudText Typo="Typo.h6" HtmlTag="h2" id="terms-dialog-title">Terms and conditions</MudText>
    </TitleContent>
    <DialogContent>
        <TermsContent />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close" data-testid="close-terms">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private void Close() => Dialog.Close();
}
