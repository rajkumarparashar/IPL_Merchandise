<section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner">
        <div class="hero__text">
            <p class="hero__eyebrow">Official IPL Merchandise</p>
            <h1 id="hero-title" class="hero__title">Your Team. Your Pride.</h1>
            <p class="hero__subtitle">Get authentic IPL merchandise and bring the stadium home.</p>
            <a href="shop" class="hero__cta">Shop Now <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a>
        </div>
        <div class="hero__art" aria-hidden="true">
            <div class="hero__item hero__item--jersey"><MerchArt Type="ProductType.Jersey" Primary="#1b3fa0" Secondary="#f2c14e" Label="FAN" /></div>
            <div class="hero__item hero__item--flag"><MerchArt Type="ProductType.Flag" Primary="#1f3c9c" Secondary="#f2c14e" Label="FAN" /></div>
            <div class="hero__item hero__item--cap"><MerchArt Type="ProductType.Cap" Primary="#14204a" Secondary="#f2c14e" /></div>
            <svg class="hero__item hero__item--ball" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="46" fill="#b3191e" />
                <circle cx="38" cy="36" r="18" fill="#fff" opacity=".12" />
                <path d="M22 18 Q50 50 22 82 M78 18 Q50 50 78 82" stroke="#f3e3c3" stroke-width="2.5" fill="none" stroke-dasharray="5 4" />
            </svg>
        </div>
    </div>
</section>
