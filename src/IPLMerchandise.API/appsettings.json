{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": { "IncludeScopes": true, "UseUtcTimestamp": true, "TimestampFormat": "O" }
    }
  },
  "AllowedHosts": "*",
  "Cosmos": {
    "DatabaseName": "ipl-merchandise",
    "StoreId": "main",
    "UseGatewayMode": false,
    "InitializeOnStartup": false,
    "SeedOnStartup": false,
    "RequestTimeoutSeconds": 10,
    "MaxRetryAttemptsOnThrottling": 5,
    "MaxRetryWaitSeconds": 15
  },
  "ImageStorage": {
    "ContainerName": "product-images",
    "CreateContainerIfMissing": false,
    "RequestTimeoutSeconds": 15
  },
  "Jwt": {
    "Issuer": "ipl-merchandise-api",
    "Audience": "ipl-merchandise-web",
    "AccessTokenMinutes": 60
  },
  "RateLimiting": {
    "SearchPerMinute": 120,
    "CheckoutPerMinute": 10,
    "AuthPerMinute": 10
  },
  "Checkout": {
    "RecoveryIntervalSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Api": {
    "EnableSwagger": false
  }
}
