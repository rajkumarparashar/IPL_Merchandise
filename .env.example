# Copy to .env for docker compose. Never commit real values.
# HMAC key for signing JWTs: at least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-bytes
# Development admin account seeded on first start.
ADMIN_EMAIL=admin@iplstore.local
ADMIN_PASSWORD=Admin@12345
